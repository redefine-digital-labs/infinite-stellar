{
  "name": "infinite-stellar",
  "version": "0.1.0",
  "private": true,
  "description": "Player client and SDK workspace for Infinite Stellar.",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @infinite-stellar/web",
    "build": "npm run build --workspace @infinite-stellar/prover && npm run build --workspace @infinite-stellar/game-sdk && npm run build --workspace @infinite-stellar/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint apps packages --max-warnings=0",
    "lint:docs": "markdownlint-cli2 README.md CONTRIBUTING.md SECURITY.md 'docs/**/*.md' 'apps/**/*.md' 'packages/**/*.md' 'ops/**/*.md' move/infinite_stellar/README.md",
    "validate:web": "npm run typecheck && npm run lint && npm run test && npm run build",
    "verify:deployment": "node ops/verify-sui-deployment.mjs",
    "verify:soulidity-mainnet": "node ops/verify-soulidity-mainnet.mjs",
    "verify:move-mainnet-dry-run": "node ops/verify-move-mainnet-dry-run.mjs",
    "circuits:fixtures": "node --experimental-strip-types circuits/scripts/create-fixtures.mjs",
    "circuits:build:dev": "node circuits/scripts/build-development-artifacts.mjs",
    "circuits:test:dev": "node circuits/scripts/test-development-proofs.mjs",
    "circuits:test:ranked": "npm exec --workspace @infinite-stellar/game-sdk -- vitest run --config vitest.circuits.config.ts",
    "circuits:export:move-fixtures": "npm run build --workspace @infinite-stellar/prover && node circuits/scripts/export-move-adapter-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@mysten/sui": "2.27.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "globals": "17.3.0",
    "markdownlint-cli2": "0.23.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  },
  "overrides": {
    "bfj": "9.1.3"
  },
  "allowScripts": {
    "@swc/core@1.16.1": true,
    "fsevents": false
  }
}
